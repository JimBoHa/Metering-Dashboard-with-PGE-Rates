[Unit]
Description=Independent utility metering dashboard
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/metering-dashboard
ExecStart=%h/metering-dashboard/.venv/bin/metering-dashboard --host 0.0.0.0 --port 8095 --data-dir %h/.local/share/metering-dashboard
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
Nice=10
MemoryMax=768M
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
